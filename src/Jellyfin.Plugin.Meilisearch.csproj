<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>1.11.1.32</Version>
        <AssemblyVersion>1.11.1.32</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Jellyfin.Controller" Version="10.11.7" />
        <PackageReference Include="Jellyfin.Database.Implementations" Version="10.11.7" />
        <PackageReference Include="Jellyfin.Model" Version="10.11.7" />
        <PackageReference Include="MeiliSearch" Version="0.18.0"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="[9.0.0,)"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="config.html"/>
        <EmbeddedResource Include="config.html"/>
        <None Remove="semantic.html"/>
        <EmbeddedResource Include="semantic.html"/>
    </ItemGroup>
    <ItemGroup>
        <!-- the paging and fall-through rules are internal on purpose: they are
             implementation, but every search depends on them being right -->
        <InternalsVisibleTo Include="Jellyfin.Plugin.Meilisearch.Tests"/>
    </ItemGroup>

</Project>
